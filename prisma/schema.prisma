generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id            String   @id @default(cuid())
  abcId         String?  @unique
  studentId     String?
  name          String
  email         String? @unique
  role          String
  credits       Int?      // add this line
  professorId   String?
  professorMail String?
  passwordHash  String?
  adminId       String?
  adminMail     String? @unique
  professorBranch String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

}
enum Role {
  Student
  Professor
  Admin
}
